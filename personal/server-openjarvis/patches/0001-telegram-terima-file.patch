 logger = logging.getLogger(__name__)
 
+# Bots may only download files up to 20 MB through getFile.
+_MAX_INBOX_BYTES = 20 * 1024 * 1024
+_UNSAFE_NAME_CHARS = re.compile(r"[^A-Za-z0-9._() -]+")
+
+
+def _safe_inbox_name(name: str) -> str:
+    """Reduce a user-supplied file name to a safe base name."""
+    base = os.path.basename((name or "").replace("\\", "/")).strip()
+    base = _UNSAFE_NAME_CHARS.sub("_", base).lstrip(".").strip()
+    if not base:
+        base = "file"
+    if len(base) > 100:
+        stem, ext = os.path.splitext(base)
+        base = stem[: 100 - len(ext)] + ext
+    return base
+
+
+def _unique_path(directory: str, name: str) -> str:
+    """Return a path in *directory* that does not overwrite an existing file."""
+    stem, ext = os.path.splitext(name)
+    candidate = os.path.join(directory, name)
+    counter = 1
+    while os.path.exists(candidate):
+        candidate = os.path.join(directory, f"{stem}-{counter}{ext}")
+        counter += 1
+    return candidate
+
 
