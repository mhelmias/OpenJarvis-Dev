diff --git a/tests/channels/test_telegram.py b/tests/channels/test_telegram.py
index 3db8376f..18b55142 100644
--- a/tests/channels/test_telegram.py
+++ b/tests/channels/test_telegram.py
@@ -764,3 +764,137 @@ class TestChannelAgentWiring:
 
         assert len(calls_a) == 1
         assert len(calls_b) == 1
+
+
+def _document_update(chat_id=111, file_name="anggaran.xlsx", file_size=10, caption=""):
+    return SimpleNamespace(
+        message=SimpleNamespace(
+            from_user=SimpleNamespace(id=chat_id),
+            chat=SimpleNamespace(id=chat_id),
+            message_id=7,
+            caption=caption,
+            document=SimpleNamespace(
+                file_id="FILE-1", file_name=file_name, file_size=file_size
+            ),
+        )
+    )
+
+
+def _document_context(downloads, payload=b"PK-data"):
+    class FakeFile:
+        async def download_to_drive(self, custom_path):
+            downloads.append(custom_path)
+            with open(custom_path, "wb") as fh:
+                fh.write(payload)
+
+    async def get_file(file_id):
+        assert file_id == "FILE-1"
+        return FakeFile()
+
+    return SimpleNamespace(bot=SimpleNamespace(get_file=get_file))
+
+
+class TestDocumentInbox:
+    """Documents from allowed chats are saved to the inbox and announced."""
+
+    def _channel(self, tmp_path, allowed="111"):
+        ch = TelegramChannel(
+            bot_token="tok", allowed_chat_ids=allowed, inbox_dir=str(tmp_path)
+        )
+        received = []
+        ch.on_message(received.append)
+        return ch, received
+
+    def test_inbox_falls_back_to_env(self, monkeypatch, tmp_path):
+        monkeypatch.setenv("OPENJARVIS_TELEGRAM_INBOX", str(tmp_path))
+        assert TelegramChannel(bot_token="tok")._inbox_dir == str(tmp_path)
+        monkeypatch.delenv("OPENJARVIS_TELEGRAM_INBOX")
+        assert TelegramChannel(bot_token="tok")._inbox_dir == ""
+
+    def test_saves_document_and_dispatches_path_with_caption(self, tmp_path):
+        ch, received = self._channel(tmp_path)
+        downloads = []
+        update = _document_update(caption="Apa isi file ini?")
+        asyncio.run(ch._handle_document(update, _document_context(downloads)))
+
+        saved = tmp_path / "anggaran.xlsx"
+        assert downloads == [str(saved)]
+        assert saved.read_bytes() == b"PK-data"
+        assert len(received) == 1
+        assert received[0].conversation_id == "111"
+        assert received[0].content == (
+            f"[File received and saved to: {saved}]\nApa isi file ini?"
+        )
+
+    def test_never_overwrites_and_sanitizes_names(self, tmp_path):
+        ch, received = self._channel(tmp_path)
+        (tmp_path / "anggaran.xlsx").write_bytes(b"old")
+        downloads = []
+        asyncio.run(
+            ch._handle_document(_document_update(), _document_context(downloads))
+        )
+        asyncio.run(
+            ch._handle_document(
+                _document_update(file_name="../../etc/pass wd?.xlsx"),
+                _document_context(downloads),
+            )
+        )
+        assert (tmp_path / "anggaran.xlsx").read_bytes() == b"old"
+        assert downloads == [
+            str(tmp_path / "anggaran-1.xlsx"),
+            str(tmp_path / "pass wd_.xlsx"),
+        ]
+
+    @pytest.mark.parametrize(("allowed", "chat_id"), [("111", 999), ("", 111)])
+    def test_ignores_unlisted_chat_or_missing_allowlist(
+        self, tmp_path, allowed, chat_id
+    ):
+        ch, received = self._channel(tmp_path, allowed=allowed)
+        downloads = []
+        asyncio.run(
+            ch._handle_document(
+                _document_update(chat_id=chat_id), _document_context(downloads)
+            )
+        )
+        assert downloads == []
+        assert received == []
+        assert list(tmp_path.iterdir()) == []
+
+    def test_too_large_document_is_not_downloaded(self, tmp_path):
+        ch, received = self._channel(tmp_path)
+        downloads = []
+        update = _document_update(file_size=25 * 1024 * 1024)
+        asyncio.run(ch._handle_document(update, _document_context(downloads)))
+        assert downloads == []
+        assert received[0].content.startswith("[File not saved: anggaran.xlsx")
+
+    def test_document_handler_only_registered_with_inbox(self, monkeypatch, tmp_path):
+        registered = {}
+        for inbox in ("", str(tmp_path)):
+            handlers = []
+            app = SimpleNamespace(add_handler=handlers.append)
+            builder = MagicMock()
+            builder.token.return_value = builder
+            builder.build.return_value = app
+            telegram_ext = SimpleNamespace(
+                ApplicationBuilder=lambda: builder,
+                MessageHandler=lambda flt, callback: SimpleNamespace(
+                    filter=flt, callback=callback
+                ),
+                filters=SimpleNamespace(
+                    TEXT="text", Document=SimpleNamespace(ALL="document")
+                ),
+            )
+            monkeypatch.setitem(sys.modules, "telegram.ext", telegram_ext)
+            ch = TelegramChannel(
+                bot_token="tok", allowed_chat_ids="111", inbox_dir=inbox
+            )
+
+            async def no_polling(_app, _stop):
+                return None
+
+            monkeypatch.setattr(ch, "_run_polling_lifecycle", no_polling)
+            ch._poll_loop()
+            registered[inbox] = [h.filter for h in handlers]
+        assert registered[""] == ["text"]
+        assert registered[str(tmp_path)] == ["text", "document"]
