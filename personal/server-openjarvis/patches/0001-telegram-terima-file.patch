     # -- internal helpers -------------------------------------------------------
 
+    def _is_allowed_chat(self, chat_id: str) -> bool:
+        """Return whether *chat_id* passes the configured allow-list."""
+        if not self._allowed_chat_ids:
+            return True
+        allowed = {
+            cid.strip() for cid in self._allowed_chat_ids.split(",") if cid.strip()
+        }
+        return chat_id in allowed
+
+    def _dispatch(self, cm: ChannelMessage) -> None:
+        """Run the registered handlers and publish the inbound event."""
+        for handler in self._handlers:
+            try:
+                handler(cm)
+            except Exception:
+                logger.exception("Telegram handler error")
+        if self._bus is not None:
+            self._bus.publish(
+                EventType.CHANNEL_MESSAGE_RECEIVED,
+                {
+                    "channel": cm.channel,
+                    "sender": cm.sender,
+                    "content": cm.content,
+                    "message_id": cm.message_id,
+                },
+            )
+
+    async def _handle_document(self, update: Any, context: Any) -> None:
+        """Save a document from an allowed chat into the inbox directory.
+
+        The agent receives a text message naming the saved path, followed by
+        the caption, so it can work on the file with its tools.
+        """
+        msg = update.message
+        if msg is None or getattr(msg, "document", None) is None:
+            return
+        chat_id = str(msg.chat.id)
+        if not self._allowed_chat_ids or not self._is_allowed_chat(chat_id):
+            logger.debug("Ignoring document from chat %s", chat_id)
+            return
+        doc = msg.document
+        name = _safe_inbox_name(getattr(doc, "file_name", "") or "")
+        if (getattr(doc, "file_size", 0) or 0) > _MAX_INBOX_BYTES:
+            note = f"[File not saved: {name} is larger than the 20 MB Telegram limit]"
+        else:
+            try:
+                os.makedirs(self._inbox_dir, exist_ok=True)
+                path = _unique_path(self._inbox_dir, name)
+                tg_file = await context.bot.get_file(doc.file_id)
+                await tg_file.download_to_drive(custom_path=path)
+                note = f"[File received and saved to: {path}]"
+            except Exception:
+                logger.exception("Failed to save Telegram document")
+                note = f"[File not saved: downloading {name} from Telegram failed]"
+        caption = (getattr(msg, "caption", "") or "").strip()
+        self._dispatch(
+            ChannelMessage(
+                channel="telegram",
+                sender=str(msg.from_user.id) if msg.from_user else "",
+                content=f"{note}\n{caption}" if caption else note,
+                message_id=str(msg.message_id),
+                conversation_id=chat_id,
+            )
+        )
+
     def _stop_requested(self, async_stop_event: asyncio.Event) -> bool:
         return self._stop_event.is_set() or async_stop_event.is_set()
 
