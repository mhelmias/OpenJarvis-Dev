[Unit]
Description=Tool Excel untuk OpenJarvis (excel-mcp-server, hanya localhost)
After=network.target

[Service]
Type=simple
User=jarvis
Group=jarvis-files
Environment=HOME=/tmp
# Hanya kelompok tool yang dibutuhkan, supaya pesan ke model tetap ringkas.
Environment=EXCEL_MCP_TOOLS=workbooks,sheets,data,formulas,tables,formatting,charts
ExecStart=/opt/jarvis-tools/excel/venv/bin/excel-mcp-server streamable-http --host 127.0.0.1 --port 8017 --allow-dir /srv/jarvis-files
UMask=0007
Restart=on-failure
RestartSec=10
MemoryMax=2G

# Kurungan: tanpa internet, tanpa akses ke kunci atau token, hanya boleh menulis ke folder kerja.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/jarvis-files
InaccessiblePaths=-/etc/openjarvis -/etc/jarvis-tools -/var/lib/openjarvis -/var/lib/jarvis-tools
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
